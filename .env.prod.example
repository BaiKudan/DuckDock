# ──────────────────────────────────────────────────────────────────────
#  DuckDock 生产环境变量模板。填好后用 SOPS/age 加密为 .env.prod.enc 再启动。
#  ⚠ 凡标 [必改] 的项,scripts/prod.sh 会在启动前预检,弱口/缺失即拒绝启动。
#  完整可选项(Langfuse / SSO / 端口等)见 .env.example。
# ──────────────────────────────────────────────────────────────────────

APP_NAME=DuckDock
DEBUG=false

# === 密钥(全部 [必改];生成命令见行尾) ===
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=__CHANGE_ME__
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUCKDOCK_CREDENTIAL_KEY=__CHANGE_ME__

# === MySQL(主库;[必改] 密码) ===
MYSQL_DATABASE=duckdock
MYSQL_USER=duckdock
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
# 注:DATABASE_URL 由 compose 注入内网地址(mysql:3306),勿在此覆盖。

# === MinIO(对象存储;[必改] root 密码) ===
MINIO_ROOT_USER=duckdock-root
MINIO_ROOT_PASSWORD=__CHANGE_ME__
# Backend/worker use this dedicated MinIO app user created by minio-init.
# Do not reuse MINIO_ROOT_*.
MINIO_ACCESS_KEY=__CHANGE_ME_APP_ACCESS_KEY__
MINIO_SECRET_KEY=__CHANGE_ME_APP_SECRET_KEY__
MINIO_BUCKET=duckdock-reports
MINIO_SECURE=false
# 签名下载 URL 对外地址:必须是终端浏览器可达的 MinIO S3 入口(上线建议 TLS 域名)
MINIO_PUBLIC_ENDPOINT=your-domain.example.com:9000

# === 对外地址 / 运行参数 ===
BACKEND_BASE_URL=https://your-domain.example.com
CORS_ORIGINS=["https://your-domain.example.com"]
HTTP_PORT=80
BACKEND_WORKERS=4
WORKER_CONCURRENCY=4
REDIS_URL=redis://redis:6379/0
AUDIT_LOG_RETENTION_DAYS=90
SCAN_LLM_TIMEOUT_SECONDS=60

# === Analysis worker(核心栈启动后可选启用;在管理台 /analysis 创建 token 后填入) ===
DUCKDOCK_ANALYSIS_WORKER_ENABLED=false
DUCKDOCK_ANALYSIS_API_BASE=http://backend:8801/api/v1
DUCKDOCK_ANALYSIS_WORKER_TOKEN=
DUCKDOCK_ANALYSIS_WORKER_NAME=DuckDock Prod Analysis Worker
DUCKDOCK_ANALYSIS_WORKER_POLL_SECONDS=60
DUCKDOCK_ANALYSIS_WORKER_LEASE_SECONDS=1800
DUCKDOCK_ANALYSIS_WORKER_WORK_DIR=/tmp/duckdock-analysis-worker
DUCKDOCK_ANALYSIS_MODE=baseline

# === 可选:Clinic / 统一 LLM(不填则 analysis-worker/agent overview 等功能降级) ===
ANTHROPIC_API_KEY=
DUCKDOCK_LLM_API_KEY=
DUCKDOCK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DUCKDOCK_LLM_MODEL=qwen3.6-plus
DUCKDOCK_LLM_ENABLE_THINKING=false
DUCKDOCK_LLM_TIMEOUT_SECONDS=120
DUCKDOCK_LLM_MAX_INPUT_CHARS=24000

# === 可选:Langfuse observability ===
CLINIC_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=production
