# ──────────────────────────────────────────────────────────────────────
#  DuckDock 生产环境变量模板。填好后用 SOPS/age 加密为 .env.prod.enc 再启动。
#  ⚠ 凡标 [必改] 的项,scripts/prod.sh 会在启动前预检,弱口/缺失即拒绝启动。
#  完整可选项(Langfuse / SSO / 端口等)见 .env.example。
# ──────────────────────────────────────────────────────────────────────

APP_NAME=DuckDock
DEBUG=false

# === 密钥(全部 [必改];生成命令见行尾) ===
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=__CHANGE_ME__
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUCKDOCK_CREDENTIAL_KEY=__CHANGE_ME__

# === MySQL(主库;[必改] 密码) ===
MYSQL_DATABASE=duckdock
MYSQL_USER=duckdock
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
# 注:DATABASE_URL 由 compose 注入内网地址(mysql:3306),勿在此覆盖。

# === MinIO(对象存储;[必改] root 密码) ===
MINIO_ROOT_USER=duckdock-root
MINIO_ROOT_PASSWORD=__CHANGE_ME__
# Backend/worker use this dedicated MinIO app user created by minio-init.
# Do not reuse MINIO_ROOT_*.
MINIO_ACCESS_KEY=__CHANGE_ME_APP_ACCESS_KEY__
MINIO_SECRET_KEY=__CHANGE_ME_APP_SECRET_KEY__
MINIO_BUCKET=duckdock-reports
MINIO_SECURE=false
# 签名下载 URL 对外地址:必须是终端浏览器可达的 MinIO S3 入口(上线建议 TLS 域名)
MINIO_PUBLIC_ENDPOINT=your-domain.example.com:9000
PACK_IMPORT_MAX_COMPRESSED_BYTES=67108864
PACK_IMPORT_MAX_UNCOMPRESSED_BYTES=268435456
PACK_IMPORT_MAX_ENTRY_BYTES=67108864
PACK_IMPORT_MAX_PAYLOADS=64
PACK_IMPORT_MAX_COMPRESSION_RATIO=100
PACK_IMPORT_MAX_MANIFEST_BYTES=131072
PACK_IMPORT_PENDING_TTL_SECONDS=86400
ADAPTER_HANDSHAKE_TTL_SECONDS=86400
ADAPTER_HANDSHAKE_REPLAY_WINDOW_SECONDS=604800
ADAPTER_MAX_CLOCK_SKEW_SECONDS=300
FLEET_HEARTBEAT_STALE_SECONDS=300

# === 对外地址 / 运行参数 ===
BACKEND_BASE_URL=https://your-domain.example.com
CORS_ORIGINS=["https://your-domain.example.com"]
HTTP_PORT=80
# 可选：提供经过鉴权和 TLS 反代的 Prometheus 地址；留空则控制台不显示外链。
VITE_PROMETHEUS_URL=
BACKEND_WORKERS=4
WORKER_CONCURRENCY=4
DUCKDOCK_PROMETHEUS_RETENTION=30d
REDIS_URL=redis://redis:6379/0
AUDIT_LOG_RETENTION_DAYS=90
SCAN_LLM_TIMEOUT_SECONDS=60
# Foundation Agent Session/Run rollout: keep disabled until tenant preflight
# passes, then enable a bounded Runtime allowlist before opening globally.
AGENT_EXECUTION_INGESTION_ENABLED=false
AGENT_EXECUTION_RUNTIME_ALLOWLIST=[]

# === Analysis worker(核心栈启动后可选启用;在管理台 /analysis 创建 token 后填入) ===
DUCKDOCK_ANALYSIS_WORKER_ENABLED=false
DUCKDOCK_ANALYSIS_API_BASE=http://backend:8801/api/v1
DUCKDOCK_ANALYSIS_WORKER_TOKEN=
DUCKDOCK_ANALYSIS_WORKER_NAME=DuckDock Prod Analysis Worker
DUCKDOCK_ANALYSIS_WORKER_POLL_SECONDS=60
DUCKDOCK_ANALYSIS_WORKER_LEASE_SECONDS=1800
DUCKDOCK_ANALYSIS_WORKER_WORK_DIR=/tmp/duckdock-analysis-worker
DUCKDOCK_ANALYSIS_MODE=baseline

# === 可选:Clinic / 统一 LLM(不填则 analysis-worker/agent overview 等功能降级) ===
ANTHROPIC_API_KEY=
DUCKDOCK_LLM_API_KEY=
DUCKDOCK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DUCKDOCK_LLM_MODEL=qwen3.6-plus
DUCKDOCK_LLM_ENABLE_THINKING=false
DUCKDOCK_LLM_TIMEOUT_SECONDS=120
DUCKDOCK_LLM_MAX_INPUT_CHARS=24000

# === 可选:Langfuse observability ===
CLINIC_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=production
LANGFUSE_COMPATIBILITY_PROFILE=langfuse-v4
PROMETHEUS_BASE_URL=http://prometheus:9090
PROMETHEUS_READINESS_TIMEOUT_SECONDS=3
# Optional semantic failure clustering. Keep disabled until both the
# Langfuse project and the embedding endpoint have passed the upgrade gate.
# Raw Observation IO and embedding vectors are used ephemerally and must not be
# persisted or logged by DuckDock.
SEMANTIC_EMBEDDING_ENABLED=false
SEMANTIC_EMBEDDING_PROFILE=openai-compatible-local
SEMANTIC_EMBEDDING_BASE_URL=
SEMANTIC_EMBEDDING_API_KEY=
SEMANTIC_EMBEDDING_TIMEOUT_SECONDS=15
ANNOTATION_QUEUE_LEASE_SECONDS=300
ANNOTATION_QUEUE_MAX_ATTEMPTS=5
ANNOTATION_QUEUE_BASE_RETRY_SECONDS=15
ANNOTATION_QUEUE_MAX_RETRY_SECONDS=900
ANNOTATION_QUEUE_DISPATCH_SCHEDULE_SECONDS=10
ANNOTATION_QUEUE_DISPATCH_BATCH_SIZE=50
SEMANTIC_MONITOR_LEASE_SECONDS=300
SEMANTIC_MONITOR_MAX_ATTEMPTS=3
SEMANTIC_MONITOR_BASE_RETRY_SECONDS=15
SEMANTIC_MONITOR_MAX_RETRY_SECONDS=900
SEMANTIC_MONITOR_DISPATCH_SCHEDULE_SECONDS=10
SEMANTIC_MONITOR_DISPATCH_BATCH_SIZE=20

# Optional S3 Collector -> Langfuse v4 OTLP export. Set through the deployment
# secret manager; never place live project keys in this file.
DUCKDOCK_LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
DUCKDOCK_LANGFUSE_PUBLIC_KEY=
DUCKDOCK_LANGFUSE_SECRET_KEY=
DUCKDOCK_LANGFUSE_OTEL_GRPC_HOST_PORT=14327
DUCKDOCK_LANGFUSE_OTEL_HTTP_HOST_PORT=14328
DUCKDOCK_LANGFUSE_OTEL_HEALTH_HOST_PORT=14133
DUCKDOCK_LANGFUSE_OTEL_METRICS_HOST_PORT=18888
DUCKDOCK_OTEL_QUEUE_SIZE=2048
DUCKDOCK_OTEL_QUEUE_MAX_BYTES=134217728

# Optional Generic OTLP bridge. Supply every credential/reference through the
# deployment secret manager and bind the receiver behind approved TLS/mTLS.
DUCKDOCK_GENERIC_OTEL_HTPASSWD=
DUCKDOCK_GENERIC_NAMESPACE_PUBLIC_ID=
DUCKDOCK_GENERIC_RUNTIME_PUBLIC_ID=
DUCKDOCK_GENERIC_TELEMETRY_SINK_PUBLIC_ID=
DUCKDOCK_GENERIC_REPORTER_TOKEN=
DUCKDOCK_GENERIC_PROVIDER_OTLP_ENDPOINT=
DUCKDOCK_GENERIC_PROVIDER_TOKEN=
DUCKDOCK_GENERIC_OTEL_QUEUE_SIZE=2048
DUCKDOCK_GENERIC_OTEL_QUEUE_MAX_BYTES=134217728

DUCKDOCK_EXECUTION_BUFFER_MAX_ITEMS=10000
DUCKDOCK_EXECUTION_BUFFER_MAX_BYTES=67108864
