resolver 127.0.0.11 valid=10s;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_timeout 1d;
ssl_session_cache shared:DuckDockTLS:10m;
ssl_session_tickets off;
ssl_certificate /run/secrets/duckdock_tls_cert;
ssl_certificate_key /run/secrets/duckdock_tls_key;

server {
    listen 8443 ssl;
    server_name ${DUCKDOCK_PUBLIC_HOST};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $duckdock_frontend frontend:8080;
        proxy_pass http://$duckdock_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        client_max_body_size 64m;
    }
}

server {
    listen 8443 ssl;
    server_name ${DUCKDOCK_MINIO_PUBLIC_HOST};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        set $duckdock_minio minio:9000;
        proxy_pass http://$duckdock_minio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        client_max_body_size 256m;
    }
}
