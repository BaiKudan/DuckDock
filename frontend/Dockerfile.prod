# 多阶段:构建静态产物 → nginx 提供 + /api 反代后端(生产)
FROM node:22-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6 AS build
WORKDIR /app
ARG VITE_PROMETHEUS_URL=""
ENV VITE_PROMETHEUS_URL=${VITE_PROMETHEUS_URL}
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.29-alpine3.23@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS runtime
RUN apk upgrade --no-cache \
    && apk del curl \
    && sed -i '/^user /d; s#^pid[[:space:]].*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/duckdock.conf
COPY --from=build /app/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /etc/nginx /usr/share/nginx/html /var/cache/nginx /var/run

FROM scratch
ARG DUCKDOCK_VERSION=2.0.0-rc.1
LABEL org.opencontainers.image.title="DuckDock frontend" \
      org.opencontainers.image.version="${DUCKDOCK_VERSION}" \
      org.opencontainers.image.source="https://github.com/BaiKudan/DuckDock"
COPY --from=runtime / /
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
