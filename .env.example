# Copy to .env and fill in values

# App
APP_NAME=DuckDock
DEBUG=true

# DuckDock business database uses MySQL 8. POSTGRES_* is kept only for the
# optional self-hosted Langfuse services in docker-compose.yml.

# Database — docker-compose reads the POSTGRES_* vars below to provision the
# container; DATABASE_URL is used by the FastAPI backend. Keep the credentials
# in sync across both — docker-compose will refuse to start if any are unset.
MYSQL_DATABASE=duckdock
MYSQL_USER=duckdock
MYSQL_PASSWORD=change-me-use-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
POSTGRES_DB=langfuse_bootstrap
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=change-me-use-a-strong-password
DATABASE_URL=mysql+aiomysql://duckdock:change-me-use-a-strong-password@localhost:3307/duckdock?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SSO_STATE_EXPIRE_MINUTES=10
SSO_EXCHANGE_EXPIRE_MINUTES=5
BACKEND_BASE_URL=http://127.0.0.1:8801
FRONTEND_BASE_URL=http://127.0.0.1:5174
# Local custom-domain validation example:
# BACKEND_BASE_URL=http://duckdock.test:8990
# FRONTEND_BASE_URL=http://duckdock.test:5175

# Git repos storage (absolute path or Docker volume mount)
REPOS_ROOT=/repos

# CORS (comma-separated)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# Local custom-domain validation example:
# CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175","http://duckdock.test:5175","http://duckdock.test:8990"]

# MinIO / S3 — MINIO_ROOT_* are read by docker-compose to provision the container;
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY are used by the backend SDK. For a local
# dev stack they are typically identical; for production, provision a dedicated
# service account instead of using the root credentials.
MINIO_ROOT_USER=duckdock
MINIO_ROOT_PASSWORD=change-me-use-a-strong-password
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Local custom-domain validation example:
# MINIO_PUBLIC_ENDPOINT=duckdock.test:9000
# Docker Compose backend/worker containers override their internal SDK endpoint
# to minio:9000 through docker-compose.yml. Keep MINIO_PUBLIC_ENDPOINT reachable
# from Reporter and Analysis Worker clients.
# DUCKDOCK_INTERNAL_MINIO_ENDPOINT=minio:9000
# DUCKDOCK_INTERNAL_REDIS_URL=redis://redis:6379/0
MINIO_ACCESS_KEY=duckdock
MINIO_SECRET_KEY=change-me-use-a-strong-password
MINIO_BUCKET=duckdock
MINIO_SECURE=false
REGISTRY_SIGNED_URL_EXPIRE_SECONDS=900
REGISTRY_SIGNED_URL_MAX_SECONDS=86400
# Deprecated dev/compat flag. Production finalize is worker-first and creates
# ReportAnalysisJob; direct ingest remains admin-only for debugging.
REPORT_UPLOAD_DIRECT_INGEST_ENABLED=false
ANALYSIS_JOB_LEASE_SECONDS=1800
ANALYSIS_RESULT_CONTENT_TYPE=application/json

# Optional DuckDock analysis worker compose profile.
# 1. Start DuckDock core first.
# 2. In admin console /analysis, create a Worker token.
# 3. Put that token below and run:
#      docker compose --profile analysis-worker up -d analysis-worker
# MINIO_PUBLIC_ENDPOINT must be reachable by both user-side Reporters and this
# worker. In local Docker Desktop setups, use host.docker.internal:9000 or a
# real LAN/domain name instead of container-local localhost.
DUCKDOCK_ANALYSIS_API_BASE=http://backend:8801/api/v1
DUCKDOCK_ANALYSIS_WORKER_TOKEN=
DUCKDOCK_ANALYSIS_WORKER_NAME=DuckDock Compose Analysis Worker
DUCKDOCK_ANALYSIS_WORKER_POLL_SECONDS=60
DUCKDOCK_ANALYSIS_WORKER_LEASE_SECONDS=1800
DUCKDOCK_ANALYSIS_WORKER_WORK_DIR=/tmp/duckdock-analysis-worker
DUCKDOCK_ANALYSIS_MODE=baseline
# Shared OpenAI-compatible LLM config. This powers the analysis worker's LLM
# mode and the admin runtime "AI overview" action. For a local gateway on the
# Docker host, use DUCKDOCK_LLM_BASE_URL=http://host.docker.internal:8080/v1.
DUCKDOCK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DUCKDOCK_LLM_MODEL=qwen3.7-max
DUCKDOCK_LLM_ENABLE_THINKING=true
DUCKDOCK_LLM_TIMEOUT_SECONDS=90
DUCKDOCK_LLM_MAX_INPUT_CHARS=24000
# Do not commit real API keys. Prefer server-side secret management.
# DUCKDOCK_LLM_API_KEY=
# DASHSCOPE_API_KEY=

# Claude API (Phase 4 — Clinic)
ANTHROPIC_API_KEY=
SKILL_GEN_API_KEY=
SKILL_GEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SKILL_GEN_MODEL=qwen3.6-plus
SKILL_SANDBOX_ENABLED=true
SKILL_SANDBOX_BACKEND=docker
SKILL_SANDBOX_TIMEOUT_SECONDS=240
# OpenClaw official backend settings
SKILL_SANDBOX_MODE=all
SKILL_SANDBOX_SCOPE=session
SKILL_SANDBOX_WORKSPACE_ACCESS=none
SKILL_SANDBOX_CACHE_ROOT=.sandbox-cache
SKILL_SANDBOX_DOCKER_IMAGE=duckdock-openclaw-sandbox:local
SKILL_SANDBOX_DOCKER_NETWORK=bridge
SKILL_SANDBOX_CLAWHUB_COMMAND=clawhub
SKILL_SANDBOX_OPENCLAW_COMMAND=openclaw
SKILL_SANDBOX_REGISTRY_URL=
# Global master switch. Actual execution still depends on namespace governance.
SKILL_SANDBOX_ENABLE_AGENT_SMOKE=false
# Optional override. Defaults to qwen/<SKILL_GEN_MODEL> when SKILL_GEN_API_KEY is configured.
SKILL_SANDBOX_AGENT_MODEL=
# Optional SSH backend settings
SKILL_SANDBOX_SSH_TARGET=
SKILL_SANDBOX_SSH_PORT=22
SKILL_SANDBOX_SSH_USER=
SKILL_SANDBOX_SSH_IDENTITY_FILE=
SKILL_SANDBOX_SSH_KNOWN_HOSTS_FILE=
SKILL_SANDBOX_SSH_WORKSPACE_ROOT=/tmp/openclaw-sandboxes
SKILL_SANDBOX_SSH_STRICT_HOST_KEY_CHECKING=true
SKILL_SANDBOX_SSH_UPDATE_HOST_KEYS=true
CLINIC_LLM_PROVIDER=openai_compatible
CLINIC_LLM_API_KEY=
CLINIC_LLM_BASE_URL=
CLINIC_LLM_MODEL=qwen3.6-plus
CLINIC_LLM_TIMEOUT_SECONDS=20
CLINIC_EVAL_MAX_SKILLS=12
CLINIC_EVAL_MODE=hybrid
CLINIC_RUBRIC_VERSION=v1
CLINIC_JUDGE_PROMPT_VERSION=v1
CLINIC_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_TIMEOUT_SECONDS=5

# ── Self-hosted Langfuse (docker-compose) ───────────────────────────
# Only needed when running the `langfuse-web` / `langfuse-worker` /
# `clickhouse` services from docker-compose.yml. Generate the secrets
# with:
#   openssl rand -hex 32   # → SALT, NEXTAUTH_SECRET
#   openssl rand -hex 32   # → ENCRYPTION_KEY (must be exactly 64 hex chars)
# When self-hosting, point the backend at it by also setting:
#   CLINIC_LANGFUSE_ENABLED=true
#   LANGFUSE_BASE_URL=http://localhost:3200
#   LANGFUSE_PUBLIC_KEY=pk-lf-duckdock-local-public
#   LANGFUSE_SECRET_KEY=sk-lf-duckdock-local-secret
LANGFUSE_HOST_PORT=3200
LANGFUSE_SALT=change-me-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=change-me-must-be-exactly-64-hex-chars-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=change-me-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_URL=http://localhost:3200
LANGFUSE_INIT_USER_EMAIL=admin@duckdock.local
LANGFUSE_INIT_USER_NAME=DuckDock Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-strong-password
LANGFUSE_S3_BUCKET=langfuse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# ── Optional component manager ──────────────────────────────────────
# The admin console uses this to start/stop optional compose profiles.
# Keep Langfuse disabled by default; install/start it from /components.
COMPONENT_MANAGER_ENABLED=true
COMPONENT_DOCKER_COMMAND=docker
COMPONENT_DOCKER_COMPOSE_FILE=./docker-compose.yml
COMPONENT_DOCKER_PROJECT_DIRECTORY=.
COMPONENT_DOCKER_TIMEOUT_SECONDS=180
COMPONENT_LANGFUSE_URL=http://127.0.0.1:3200

# --- Runtime credential encryption (specs/001 FR-016) ---
# Fernet key for encrypting runtime credentials at rest (independent from SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUCKDOCK_CREDENTIAL_KEY=
