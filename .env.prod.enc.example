# Example only. Do not use this file directly.
#
# Production deploys must commit .env.prod.enc created with SOPS/age:
#
#   cp .env.prod.example .env.prod
#   $EDITOR .env.prod
#   age-keygen -o keys/duckdock-prod-age.txt
#   age-keygen -y keys/duckdock-prod-age.txt
#   # put that public recipient into .sops.yaml
#   SOPS_AGE_KEY_FILE=keys/duckdock-prod-age.txt sops --encrypt .env.prod > .env.prod.enc
#   rm -f .env.prod
#
# scripts/prod.sh refuses to run without .env.prod.enc and SOPS_AGE_KEY_FILE
# or SOPS_AGE_KEY. It never falls back to plaintext .env.prod.
