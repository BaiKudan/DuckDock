{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckdock.local/schemas/tenant-remediation-manifest-v1.schema.json",
  "title": "DuckDock Tenant Remediation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "change_ticket",
    "reason",
    "approved_by_user_id",
    "assignments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "change_ticket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "approved_by_user_id": {
      "type": "integer",
      "minimum": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "target_id",
        "namespace_id"
      ],
      "properties": {
        "target_type": {
          "enum": [
            "runtime_instance",
            "ai_asset",
            "runtime_binding",
            "work_trace",
            "evidence_item"
          ]
        },
        "target_id": {
          "type": "integer",
          "minimum": 1
        },
        "namespace_id": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 1000
        }
      }
    }
  }
}
