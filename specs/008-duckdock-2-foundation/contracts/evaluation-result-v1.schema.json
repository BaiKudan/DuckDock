{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckdock.dev/schemas/evaluation-result-v1.schema.json",
  "title": "DuckDock Evaluation Result v1",
  "description": "Reproducible quality evaluation summary used as evidence by DuckDock release gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "evaluation_run_id",
    "status",
    "subject",
    "dataset",
    "evaluator",
    "metrics",
    "summary",
    "decision",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "completed",
      "description": "EvaluationResult is immutable terminal evidence; queued/running/failed lifecycle belongs to EvalRun."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_id", "agent_asset_id", "package_id", "release_id"],
      "properties": {
        "namespace_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_release_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version_id", "content_sha256", "item_count"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "version", "type", "config_sha256"],
      "properties": {
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["deterministic", "llm_judge", "agentic", "human", "composite"]
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "judge_model": {
          "type": "string",
          "minLength": 1
        },
        "judge_prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_total",
        "items_evaluated",
        "items_passed",
        "items_failed",
        "items_error",
        "duration_ms"
      ],
      "properties": {
        "items_total": {
          "type": "integer",
          "minimum": 1
        },
        "items_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "items_passed": {
          "type": "integer",
          "minimum": 0
        },
        "items_failed": {
          "type": "integer",
          "minimum": 0
        },
        "items_error": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "judge_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "judge_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "blocking_reasons", "warnings"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "review", "inconclusive"]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "runner_id", "started_at", "completed_at"],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "runner_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "score", "threshold", "comparison", "passed", "sample_count", "error_count"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "score": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "comparison": {
          "type": "string",
          "enum": ["gte", "lte", "eq"]
        },
        "passed": {
          "type": "boolean"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_score": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "external_run_id", "uri", "sha256"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "external_run_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
