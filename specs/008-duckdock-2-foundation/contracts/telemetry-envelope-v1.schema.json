{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckdock.dev/schemas/telemetry-envelope-v1.schema.json",
  "title": "DuckDock Telemetry Envelope v1",
  "description": "Provider-neutral execution trace summary correlated to DuckDock-governed assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "emitted_at",
    "provider",
    "correlation",
    "trace",
    "summary",
    "content_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "project_id", "external_trace_id"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "external_trace_id": {
          "type": "string",
          "minLength": 1
        },
        "deep_link": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_id", "agent_asset_id", "runtime_instance_id", "release_id"],
      "properties": {
        "namespace_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "work_trace_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_version_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version_id": {
          "type": "string",
          "minLength": 1
        },
        "reporter_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "root_span_id", "started_at", "ended_at", "status", "span_kinds"],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "root_span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "error", "cancelled", "timeout", "unknown"]
        },
        "span_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["agent", "model", "tool", "retrieval", "memory", "workflow", "other"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_count",
        "model_call_count",
        "tool_call_count",
        "retrieval_count",
        "retry_count",
        "error_count",
        "input_tokens",
        "output_tokens",
        "duration_ms"
      ],
      "properties": {
        "span_count": {
          "type": "integer",
          "minimum": 1
        },
        "model_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "content_policy": {
      "type": "string",
      "enum": ["disabled", "metadata_only", "sampled_content", "full_content"]
    },
    "attributes": {
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "enum": [
          "deployment.environment",
          "deployment.region",
          "service.name",
          "service.version",
          "gen_ai.operation.name",
          "gen_ai.provider.name",
          "gen_ai.request.model",
          "duckdock.asset_version_ids",
          "duckdock.normalizer.version",
          "harness.version"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "maxLength": 2000},
          {"type": "number"},
          {"type": "boolean"},
          {
            "type": "array",
            "maxItems": 100,
            "items": {
              "oneOf": [
                {"type": "string", "maxLength": 500},
                {"type": "number"},
                {"type": "boolean"}
              ]
            }
          }
        ]
      }
    }
  }
}
